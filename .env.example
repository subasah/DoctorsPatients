# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# OpenAI Configuration (Optional - for AI-powered SOAP generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure Configuration (Optional - for Azure Health Text Analytics)
AZURE_TEXT_ANALYTICS_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_TEXT_ANALYTICS_KEY=your-azure-key-here

# AWS Configuration (Optional - for AWS Comprehend Medical)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Epic FHIR Configuration (Configure in app settings instead)
# EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# EPIC_CLIENT_ID=your-epic-client-id
# EPIC_CLIENT_SECRET=your-epic-client-secret

# App Configuration
APP_ENV=development
LOG_LEVEL=debug

# Feature Flags
ENABLE_AI_ENHANCEMENT=false
ENABLE_EPIC_INTEGRATION=false
ENABLE_ANALYTICS=false
